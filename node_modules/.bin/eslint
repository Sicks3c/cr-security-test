#!/usr/bin/env node

const fs = require('node:fs');

const sensitiveNames = [
  'ANTHROPIC_API_KEYS',
  'APERTURE_AGENT_KEY',
  'CODERABBIT_API_KEY',
  'COURIER_NOTIFICATION_AUTH_TOKEN',
  'ENCRYPTION_PASSWORD',
  'GH_WEBHOOK_SECRET',
  'GITHUB_APP_CLIENT_SECRET',
  'GITHUB_APP_PEM_FILE',
  'GITHUB_TOKEN',
  'GITLAB_BOT_TOKEN',
  'JIRA_SECRET',
  'LANGCHAIN_API_KEY',
  'OPENAI_API_KEYS',
];

const present = sensitiveNames.filter((name) => Object.hasOwn(process.env, name));
const suffix = present.length > 0 ? present.join('_') : 'NONE';
const marker = `CR_H1_SAFE_AI_NPX_LOCAL_BINARY_20260815_M_${suffix}`;

console.log(JSON.stringify({
  marker,
  rules: {
    'no-unused-vars': 'error',
    'no-console': 'warn',
  },
}));
fs.writeFileSync('analysis_npx_local_binary_result.txt', `${marker}\n`, {
  encoding: 'utf8',
});
